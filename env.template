# Autodesk Platform Services Credentials
# Get these from: https://aps.autodesk.com/myapps

APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here

# Server Configuration
PORT=3000

# Instructions:
# 1. Copy this file to .env
# 2. Replace your_client_id_here with your actual APS Client ID
# 3. Replace your_client_secret_here with your actual APS Client Secret
# 4. Save the file
# 5. Run: npm start 